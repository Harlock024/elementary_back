# Required in every environment. Use True only for local development.
# Production must set this explicitly to False and inject secrets from a secret store.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

DB_ENGINE=django.db.backends.postgresql
DB_NAME=elementary_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-local-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
CSRF_TRUSTED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_LOGIN_RATE=5/min
DJANGO_LANGUAGE_CODE=es-mx
DJANGO_TIME_ZONE=America/Mexico_City

# Enable this only when a trusted reverse proxy sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False
